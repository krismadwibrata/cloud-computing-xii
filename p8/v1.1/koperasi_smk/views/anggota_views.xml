<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_koperasi_anggota_list" model="ir.ui.view">
        <field name="name">koperasi.anggota.list</field>
        <field name="model">koperasi.anggota</field>
        <field name="arch" type="xml">
            <list>
                <field name="nomor_anggota"/>
                <field name="name"/>
                <field name="kelas"/>
                <field name="tanggal_gabung"/>
                <field name="saldo_simpanan"/>
            </list>
        </field>
    </record>

    <record id="view_koperasi_anggota_form" model="ir.ui.view">
        <field name="name">koperasi.anggota.form</field>
        <field name="model">koperasi.anggota</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="nomor_anggota"/>
                        <field name="name"/>
                        <field name="kelas"/>
                        <field name="tanggal_gabung"/>
                        <field name="saldo_simpanan"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_koperasi_anggota" model="ir.actions.act_window">
        <field name="name">Anggota Koperasi (v1.1)</field>
        <field name="res_model">koperasi.anggota</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_koperasi_root" name="Koperasi SMK Telkom" sequence="10"/>
    <menuitem id="menu_koperasi_anggota" name="Anggota" parent="menu_koperasi_root"
              action="action_koperasi_anggota" sequence="10"/>
</odoo>
